{
  "specification": {
    "standard": "DDT-RELATIONSHIP-VOCABULARY",
    "version": "0.1.0-draft.1"
  },
  "vocabularyId": "https://diamonddatachain.org/vocabularies/ddt-relationships/base",
  "vocabularyVersion": "0.1.0-draft.1",
  "lifecycleStatus": "DRAFT",
  "directionModel": "SOURCE_TO_TARGET",
  "closurePolicy": "CLOSED",
  "inferencePolicy": {
    "implicitInverseEdges": false,
    "implicitTransitiveEdges": false,
    "implicitSymmetricEdges": false,
    "derivedEdgesMustBeLabeled": true
  },
  "targetBindingPolicy": {
    "recordIdRequired": true,
    "recordHashRequired": true,
    "registrationTimeResolutionRequired": true,
    "selfReferencePermitted": false,
    "displayIdPermittedAsTarget": false
  },
  "types": [
    {
      "code": "CONFIRMS_ASSERTION",
      "category": "ASSERTION_EVALUATION",
      "direction": "SOURCE_TO_TARGET",
      "definition": "The source asserts support for a specifically scoped assertion contained in the target; it does not confirm the whole target or establish substantive truth.",
      "assertedByRequirement": "REQUIRED",
      "asserterIdentityRefRequirement": "REQUIRED",
      "evidenceRequirement": "AT_LEAST_ONE",
      "semanticScopeRequirement": "REQUIRED",
      "authorityRequirement": "PROFILE_DEFINED",
      "effectiveBoundaryRequirement": "NOT_REQUIRED",
      "targetEffect": "CONFIRMATION_ASSERTED",
      "transitive": false,
      "symmetric": false,
      "impliesTargetInvalidity": false,
      "impliesSubstantiveTruth": false
    },
    {
      "code": "CONTRADICTS_ASSERTION",
      "category": "ASSERTION_EVALUATION",
      "direction": "SOURCE_TO_TARGET",
      "definition": "The source asserts conflict with a specifically scoped assertion contained in the target; it does not establish which assertion is correct or invalidate the whole target.",
      "assertedByRequirement": "REQUIRED",
      "asserterIdentityRefRequirement": "REQUIRED",
      "evidenceRequirement": "AT_LEAST_ONE",
      "semanticScopeRequirement": "REQUIRED",
      "authorityRequirement": "PROFILE_DEFINED",
      "effectiveBoundaryRequirement": "NOT_REQUIRED",
      "targetEffect": "CONTRADICTION_ASSERTED",
      "transitive": false,
      "symmetric": false,
      "impliesTargetInvalidity": false,
      "impliesSubstantiveTruth": false
    },
    {
      "code": "CORRECTS",
      "category": "SUCCESSION",
      "direction": "SOURCE_TO_TARGET",
      "definition": "The source asserts a correction to a specifically identified aspect of the target without erasing the target, proving it wrong or implying complete replacement.",
      "assertedByRequirement": "REQUIRED",
      "asserterIdentityRefRequirement": "REQUIRED",
      "evidenceRequirement": "AT_LEAST_ONE",
      "semanticScopeRequirement": "REQUIRED",
      "authorityRequirement": "PROFILE_DEFINED",
      "effectiveBoundaryRequirement": "PROFILE_DEFINED",
      "targetEffect": "CORRECTION_ASSERTED",
      "transitive": false,
      "symmetric": false,
      "impliesTargetInvalidity": false,
      "impliesSubstantiveTruth": false
    },
    {
      "code": "DERIVED_FROM",
      "category": "PROVENANCE",
      "direction": "SOURCE_TO_TARGET",
      "definition": "The source asserts that its content or result was produced using or transforming the target; it does not imply equality, equivalence, endorsement, correctness or reproducibility.",
      "assertedByRequirement": "REQUIRED",
      "asserterIdentityRefRequirement": "REQUIRED",
      "evidenceRequirement": "AT_LEAST_ONE",
      "semanticScopeRequirement": "PROFILE_DEFINED",
      "authorityRequirement": "NOT_REQUIRED",
      "effectiveBoundaryRequirement": "NOT_REQUIRED",
      "targetEffect": "DERIVATION_ASSERTED",
      "transitive": false,
      "symmetric": false,
      "impliesTargetInvalidity": false,
      "impliesSubstantiveTruth": false
    },
    {
      "code": "DISPUTES",
      "category": "DIALOGUE",
      "direction": "SOURCE_TO_TARGET",
      "definition": "The source asserts a challenge to a scoped claim, interpretation, authority, result or other aspect of the target without establishing that the dispute is justified or resolved.",
      "assertedByRequirement": "REQUIRED",
      "asserterIdentityRefRequirement": "REQUIRED",
      "evidenceRequirement": "AT_LEAST_ONE",
      "semanticScopeRequirement": "PROFILE_DEFINED",
      "authorityRequirement": "PROFILE_DEFINED",
      "effectiveBoundaryRequirement": "NOT_REQUIRED",
      "targetEffect": "DISPUTE_ASSERTED",
      "transitive": false,
      "symmetric": false,
      "impliesTargetInvalidity": false,
      "impliesSubstantiveTruth": false
    },
    {
      "code": "REFERENCES",
      "category": "REFERENCE",
      "direction": "SOURCE_TO_TARGET",
      "definition": "The source cites or points to the target for context without asserting dependency, agreement, disagreement, derivation, correction, replacement, reversal, succession or invalidity.",
      "assertedByRequirement": "OPTIONAL",
      "asserterIdentityRefRequirement": "OPTIONAL",
      "evidenceRequirement": "OPTIONAL",
      "semanticScopeRequirement": "NOT_REQUIRED",
      "authorityRequirement": "NOT_REQUIRED",
      "effectiveBoundaryRequirement": "NOT_REQUIRED",
      "targetEffect": "NONE",
      "transitive": false,
      "symmetric": false,
      "impliesTargetInvalidity": false,
      "impliesSubstantiveTruth": false
    },
    {
      "code": "REMEDIES",
      "category": "REMEDIATION",
      "direction": "SOURCE_TO_TARGET",
      "definition": "The source asserts an action or state intended to remedy a specifically identified issue associated with the target without proving adequacy, success or legal sufficiency.",
      "assertedByRequirement": "REQUIRED",
      "asserterIdentityRefRequirement": "REQUIRED",
      "evidenceRequirement": "AT_LEAST_ONE",
      "semanticScopeRequirement": "PROFILE_DEFINED",
      "authorityRequirement": "PROFILE_DEFINED",
      "effectiveBoundaryRequirement": "PROFILE_DEFINED",
      "targetEffect": "REMEDY_ASSERTED",
      "transitive": false,
      "symmetric": false,
      "impliesTargetInvalidity": false,
      "impliesSubstantiveTruth": false
    },
    {
      "code": "REPLACES",
      "category": "SUCCESSION",
      "direction": "SOURCE_TO_TARGET",
      "definition": "The source asserts that it substitutes for the target in a defined role or use without implying that the target was incorrect, erased or reversed.",
      "assertedByRequirement": "REQUIRED",
      "asserterIdentityRefRequirement": "REQUIRED",
      "evidenceRequirement": "AT_LEAST_ONE",
      "semanticScopeRequirement": "REQUIRED",
      "authorityRequirement": "PROFILE_DEFINED",
      "effectiveBoundaryRequirement": "PROFILE_DEFINED",
      "targetEffect": "SUBSTITUTION_ASSERTED",
      "transitive": false,
      "symmetric": false,
      "impliesTargetInvalidity": false,
      "impliesSubstantiveTruth": false
    },
    {
      "code": "RESPONDS_TO",
      "category": "DIALOGUE",
      "direction": "SOURCE_TO_TARGET",
      "definition": "The source asserts that it is a response to the target without implying agreement, correction, acceptance, replacement or dispute resolution.",
      "assertedByRequirement": "REQUIRED",
      "asserterIdentityRefRequirement": "REQUIRED",
      "evidenceRequirement": "AT_LEAST_ONE",
      "semanticScopeRequirement": "PROFILE_DEFINED",
      "authorityRequirement": "PROFILE_DEFINED",
      "effectiveBoundaryRequirement": "NOT_REQUIRED",
      "targetEffect": "RESPONSE_ASSERTED",
      "transitive": false,
      "symmetric": false,
      "impliesTargetInvalidity": false,
      "impliesSubstantiveTruth": false
    },
    {
      "code": "REVERSES",
      "category": "SUCCESSION",
      "direction": "SOURCE_TO_TARGET",
      "definition": "The source asserts that a defined target outcome, decision or state is reversed within a specified scope without erasing the target or proving authorization, effectiveness or justification.",
      "assertedByRequirement": "REQUIRED",
      "asserterIdentityRefRequirement": "REQUIRED",
      "evidenceRequirement": "AT_LEAST_ONE",
      "semanticScopeRequirement": "REQUIRED",
      "authorityRequirement": "PROFILE_DEFINED",
      "effectiveBoundaryRequirement": "PROFILE_DEFINED",
      "targetEffect": "REVERSAL_ASSERTED",
      "transitive": false,
      "symmetric": false,
      "impliesTargetInvalidity": false,
      "impliesSubstantiveTruth": false
    },
    {
      "code": "SUPERSEDES",
      "category": "SUCCESSION",
      "direction": "SOURCE_TO_TARGET",
      "definition": "The source asserts precedence over the target for a defined semantic scope from an asserted effective boundary onward without deleting or altering the historical target.",
      "assertedByRequirement": "REQUIRED",
      "asserterIdentityRefRequirement": "REQUIRED",
      "evidenceRequirement": "AT_LEAST_ONE",
      "semanticScopeRequirement": "REQUIRED",
      "authorityRequirement": "PROFILE_DEFINED",
      "effectiveBoundaryRequirement": "PROFILE_DEFINED",
      "targetEffect": "PRECEDENCE_ASSERTED",
      "transitive": false,
      "symmetric": false,
      "impliesTargetInvalidity": false,
      "impliesSubstantiveTruth": false
    }
  ],
  "errorCodes": [
    "RELATIONSHIP_ASSERTED_BY_REQUIRED",
    "RELATIONSHIP_AUTHORITY_UNRESOLVED",
    "RELATIONSHIP_CONFLICT_UNRESOLVED",
    "RELATIONSHIP_DUPLICATE",
    "RELATIONSHIP_EFFECTIVE_BOUNDARY_UNRESOLVED",
    "RELATIONSHIP_EVIDENCE_REQUIRED",
    "RELATIONSHIP_EVIDENCE_UNRESOLVED",
    "RELATIONSHIP_EXTENSION_UNBOUND",
    "RELATIONSHIP_ORDER_INVALID",
    "RELATIONSHIP_SCOPE_UNRESOLVED",
    "RELATIONSHIP_TARGET_AMBIGUOUS",
    "RELATIONSHIP_TARGET_HASH_MISMATCH",
    "RELATIONSHIP_TARGET_SELF",
    "RELATIONSHIP_TARGET_UNRESOLVED",
    "RELATIONSHIP_TYPE_UNKNOWN"
  ]
}
