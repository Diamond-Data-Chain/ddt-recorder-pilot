{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diamonddatachain.org/specifications/ddt/cryptographic-renewal/0.1.0-draft.1/event.schema.json",
  "title": "DDT Cryptographic Renewal Event v0.1 Draft.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["specification", "renewalCore", "renewalCoreHash", "renewalProofs", "renewalTimeEvidenceRefs"],
  "properties": {
    "specification": { "$ref": "#/$defs/specification" },
    "renewalCore": { "$ref": "#/$defs/renewalCore" },
    "renewalCoreHash": { "$ref": "#/$defs/digest" },
    "renewalProofs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/artifactReference" }
    },
    "renewalTimeEvidenceRefs": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 512 },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "version", "digest"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "digest": { "$ref": "#/$defs/digest" },
        "immutableRef": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "version"],
      "properties": {
        "standard": { "const": "DDT-CRYPTOGRAPHIC-RENEWAL-EVENT" },
        "version": { "const": "0.1.0-draft.1" }
      }
    },
    "renewalTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetType", "targetId", "targetCommitment", "originalArtifactRefs", "originalProofRefs", "originalProfileRefs"],
      "properties": {
        "targetType": {
          "enum": [
            "DDT_RECORD_HASH",
            "OFFLINE_PACKAGE_MANIFEST_CORE_HASH",
            "EVIDENCE_PACKAGE_MANIFEST_HASH",
            "CHECKPOINT_CORE_HASH",
            "EXTERNAL_ATTESTATION_HASH"
          ]
        },
        "targetId": { "$ref": "#/$defs/identifier" },
        "targetCommitment": { "$ref": "#/$defs/digest" },
        "originalArtifactRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/artifactReference" }
        },
        "originalProofRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/artifactReference" }
        },
        "originalProfileRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/artifactReference" }
        }
      }
    },
    "proofEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proofRef",
        "proofScope",
        "verificationStatus",
        "algorithmPolicyStatus",
        "verifiedAtClaim",
        "verificationResultRef"
      ],
      "properties": {
        "proofRef": { "$ref": "#/$defs/artifactReference" },
        "proofScope": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "verificationStatus": {
          "enum": ["VALID", "INVALID", "UNAVAILABLE", "UNSUPPORTED", "NOT_EVALUATED"]
        },
        "algorithmPolicyStatus": {
          "enum": [
            "ACCEPTABLE",
            "DEPRECATED_BUT_ACCEPTABLE_FOR_RENEWAL",
            "PROHIBITED",
            "COMPROMISED",
            "UNKNOWN",
            "NOT_EVALUATED"
          ]
        },
        "verifiedAtClaim": { "type": "string", "format": "date-time" },
        "verificationResultRef": { "$ref": "#/$defs/artifactReference" }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggerType", "policyRef", "triggeredAtClaim", "triggerEvidenceRefs"],
      "properties": {
        "triggerType": {
          "enum": [
            "SCHEDULED_AGE_THRESHOLD",
            "PLANNED_ALGORITHM_DEPRECATION",
            "KEY_OR_TRUST_ANCHOR_MIGRATION",
            "NEW_CRYPTOGRAPHIC_WEAKNESS",
            "ARCHIVE_OR_CHECKPOINT_POLICY",
            "REGULATORY_RETENTION_REQUIREMENT",
            "MANUAL_CONTROLLED_MIGRATION"
          ]
        },
        "policyRef": { "$ref": "#/$defs/artifactReference" },
        "triggeredAtClaim": { "type": "string", "format": "date-time" },
        "triggerEvidenceRefs": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["witnessRef", "verificationMethodRef", "identityEvidenceRefs", "authorityEvidenceRefs", "scope"],
      "properties": {
        "witnessRef": { "$ref": "#/$defs/identifier" },
        "verificationMethodRef": { "$ref": "#/$defs/identifier" },
        "identityEvidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "authorityEvidenceRefs": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "scope": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renewalImpliesSubstantiveTruth",
        "renewalImpliesLegalValidity",
        "renewalImpliesHistoricalSignerAuthority",
        "boundTimeClaimImpliesIndependentTime",
        "renewalRestoresAlreadyUnverifiableProof",
        "renewalModifiesOriginalEvidence"
      ],
      "properties": {
        "renewalImpliesSubstantiveTruth": { "const": false },
        "renewalImpliesLegalValidity": { "const": false },
        "renewalImpliesHistoricalSignerAuthority": { "const": false },
        "boundTimeClaimImpliesIndependentTime": { "const": false },
        "renewalRestoresAlreadyUnverifiableProof": { "const": false },
        "renewalModifiesOriginalEvidence": { "const": false }
      }
    },
    "renewalCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "renewalEventId",
        "renewalClass",
        "renewalProfile",
        "target",
        "scope",
        "trigger",
        "originalVerificationProcedure",
        "verifierImplementation",
        "proofEvaluations",
        "aggregateVerificationResultRef",
        "newCryptographicProfile",
        "renewingWitness",
        "verificationAtClaim",
        "predecessorRenewalRefs",
        "claimBoundary"
      ],
      "properties": {
        "domain": { "const": "DDT_CRYPTOGRAPHIC_RENEWAL_CORE_V1" },
        "renewalEventId": { "$ref": "#/$defs/identifier" },
        "renewalClass": {
          "enum": ["SUCCESSFUL_RENEWAL", "FAILED_RENEWAL_ATTEMPT", "PRESERVATION_ONLY_MIGRATION"]
        },
        "renewalProfile": { "$ref": "#/$defs/artifactReference" },
        "target": { "$ref": "#/$defs/renewalTarget" },
        "scope": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "trigger": { "$ref": "#/$defs/trigger" },
        "originalVerificationProcedure": { "$ref": "#/$defs/artifactReference" },
        "verifierImplementation": { "$ref": "#/$defs/artifactReference" },
        "proofEvaluations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/proofEvaluation" }
        },
        "aggregateVerificationResultRef": { "$ref": "#/$defs/artifactReference" },
        "newCryptographicProfile": { "$ref": "#/$defs/artifactReference" },
        "renewingWitness": { "$ref": "#/$defs/witness" },
        "verificationAtClaim": { "type": "string", "format": "date-time" },
        "predecessorRenewalRefs": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/artifactReference" }
        },
        "claimBoundary": { "$ref": "#/$defs/claimBoundary" }
      }
    }
  }
}
