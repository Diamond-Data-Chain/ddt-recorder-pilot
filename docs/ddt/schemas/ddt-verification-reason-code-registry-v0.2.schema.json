{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diamonddatachain.org/specifications/ddt/verification-reason-code-registry/0.2.0-draft.1/schema.json",
  "title": "DDT Verification Reason Code Registry v0.2 Draft.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specification",
    "registryId",
    "lifecycleStatus",
    "deploymentStatus",
    "reasonCodes",
    "extensionRule"
  ],
  "properties": {
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "version"],
      "properties": {
        "standard": {"const": "DDT-VERIFICATION-REASON-CODE-REGISTRY"},
        "version": {"const": "0.2.0-draft.1"}
      }
    },
    "registryId": {"const": "ddt.verification.reason-code-registry.v2"},
    "lifecycleStatus": {"const": "DRAFT"},
    "deploymentStatus": {"const": "TEST_ONLY"},
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
      }
    },
    "extensionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCodePrefix", "baseCodeRedefinition", "unknownBaseCode"],
      "properties": {
        "reasonCodePrefix": {"const": "x:"},
        "baseCodeRedefinition": {"const": "FORBIDDEN"},
        "unknownBaseCode": {"const": "REJECT"}
      }
    }
  }
}
