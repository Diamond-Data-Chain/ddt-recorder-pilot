{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diamonddatachain.org/specifications/ddt/verification-axis-registry/0.2.0-draft.1/schema.json",
  "title": "DDT Verification Axis Registry v0.2 Draft.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specification",
    "registryId",
    "lifecycleStatus",
    "deploymentStatus",
    "statusClasses",
    "axes",
    "extensionRule"
  ],
  "properties": {
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "version"],
      "properties": {
        "standard": {"const": "DDT-VERIFICATION-AXIS-REGISTRY"},
        "version": {"const": "0.2.0-draft.1"}
      }
    },
    "registryId": {"const": "ddt.verification.axis-registry.v2"},
    "lifecycleStatus": {"const": "DRAFT"},
    "deploymentStatus": {"const": "TEST_ONLY"},
    "statusClasses": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {"$ref": "#/$defs/statusClassDefinition"}
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/axisDefinition"}
    },
    "extensionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axisIdPrefix", "baseAxisRedefinition", "unknownRequiredAxis"],
      "properties": {
        "axisIdPrefix": {"const": "x:"},
        "baseAxisRedefinition": {"const": "FORBIDDEN"},
        "unknownRequiredAxis": {"const": "REJECT"}
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    },
    "statusClass": {
      "enum": [
        "AVAILABILITY",
        "BINDING",
        "COMPLETENESS",
        "CONFORMANCE",
        "CONTINUITY",
        "FINALITY",
        "INTEGRITY",
        "LIFECYCLE",
        "PRESERVATION",
        "REPRODUCTION",
        "RESOLUTION",
        "SEMANTIC",
        "TIME",
        "TRUTH_BOUNDARY",
        "VALIDITY"
      ]
    },
    "statusClassDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statusClass", "statuses"],
      "properties": {
        "statusClass": {"$ref": "#/$defs/statusClass"},
        "statuses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "axisDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axisId", "statusClass"],
      "properties": {
        "axisId": {"$ref": "#/$defs/identifier"},
        "statusClass": {"$ref": "#/$defs/statusClass"}
      }
    }
  }
}
