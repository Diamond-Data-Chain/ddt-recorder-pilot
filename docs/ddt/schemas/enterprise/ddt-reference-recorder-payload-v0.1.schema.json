{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diamonddatachain.org/specifications/ddt/enterprise/reference-recorder/payload/0.1/schema.json",
  "title": "DDT Reference Recorder Payload v0.1",
  "description": "TEST_ONLY payload schema for the DDT Reference Recorder baseline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publisher",
    "description"
  ],
  "properties": {
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  }
}
