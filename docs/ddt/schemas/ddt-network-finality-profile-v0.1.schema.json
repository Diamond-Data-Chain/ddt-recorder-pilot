{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diamonddatachain.org/specifications/ddt/network-finality/0.1.0-draft.1/profile.schema.json",
  "title": "DDT Network Finality Profile v0.1 Draft.1",
  "description": "Machine-readable test-only profile for deterministic network target binding, transaction inclusion and certificate finality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specification",
    "profileId",
    "profileVersion",
    "lifecycleStatus",
    "deploymentStatus",
    "requiredArtifacts",
    "networkIdentity",
    "transaction",
    "inclusionTree",
    "blockHeader",
    "finality",
    "forkHandling",
    "timePolicy",
    "resultModel",
    "claimBoundary",
    "errorCodes"
  ],
  "properties": {
    "specification": { "$ref": "#/$defs/specification" },
    "profileId": { "const": "ddt.network-finality.deterministic-test-v1" },
    "profileVersion": { "const": "0.1.0-draft.1" },
    "lifecycleStatus": { "const": "DRAFT" },
    "deploymentStatus": { "const": "TEST_ONLY" },
    "requiredArtifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/artifactReference" }
    },
    "networkIdentity": { "$ref": "#/$defs/networkIdentity" },
    "transaction": { "$ref": "#/$defs/transaction" },
    "inclusionTree": { "$ref": "#/$defs/inclusionTree" },
    "blockHeader": { "$ref": "#/$defs/blockHeader" },
    "finality": { "$ref": "#/$defs/finality" },
    "forkHandling": { "$ref": "#/$defs/forkHandling" },
    "timePolicy": { "$ref": "#/$defs/timePolicy" },
    "resultModel": { "$ref": "#/$defs/resultModel" },
    "claimBoundary": { "$ref": "#/$defs/claimBoundary" },
    "errorCodes": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^NETWORK_[A-Z0-9_]+$"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "version", "digest"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/identifier" },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "digest": { "$ref": "#/$defs/digest" },
        "immutableRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "version"],
      "properties": {
        "standard": { "const": "DDT-NETWORK-FINALITY-PROFILE" },
        "version": { "const": "0.1.0-draft.1" }
      }
    },
    "networkIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "networkId",
        "networkClass",
        "genesisCommitmentInput",
        "genesisCommitment",
        "chainId",
        "protocolUpgradePolicy"
      ],
      "properties": {
        "networkId": { "const": "ddt-test-ledger-v1" },
        "networkClass": { "const": "TEST_LEDGER" },
        "genesisCommitmentInput": { "const": "UTF8(DDT_TEST_LEDGER_GENESIS_V1)" },
        "genesisCommitment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "const": "SHA-256" },
            "value": { "const": "893ffb702b2801ab493b804981cace29159e1c6ce8977c3dbbb5b1fd898f3acc" }
          }
        },
        "chainId": { "const": "ddt-test-1" },
        "protocolUpgradePolicy": { "const": "NO_UPGRADES_TEST_PROFILE" }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "canonicalization",
        "encoding",
        "transactionIdAlgorithm",
        "canonicalTransactionBytes",
        "transactionIdInput",
        "transactionBytesCommitmentInput",
        "targetExtractionMode",
        "targetJsonPointer",
        "allowedTargetTypes"
      ],
      "properties": {
        "domain": { "const": "DDT_TEST_TRANSACTION_V1" },
        "canonicalization": { "const": "RFC8785-JCS" },
        "encoding": { "const": "UTF-8" },
        "transactionIdAlgorithm": { "const": "SHA-256" },
        "canonicalTransactionBytes": { "const": "UTF8(RFC8785-JCS(transactionCore))" },
        "transactionIdInput": { "const": "canonicalTransactionBytes" },
        "transactionBytesCommitmentInput": { "const": "canonicalTransactionBytes" },
        "targetExtractionMode": { "const": "EXACT_TRANSACTION_TARGET_OBJECT" },
        "targetJsonPointer": { "const": "/target" },
        "allowedTargetTypes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "DDT_RECORD_HASH",
              "DDT_REGISTRATION_STATEMENT_HASH",
              "DDT_CHECKPOINT_CORE_HASH",
              "DDT_COVERAGE_STATEMENT_CORE_HASH"
            ]
          }
        }
      }
    },
    "inclusionTree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leafDomain",
        "canonicalization",
        "encoding",
        "digestAlgorithm",
        "leafPrefixHex",
        "internalNodePrefixHex",
        "leafHashInput",
        "internalNodeHashInput",
        "auditPathOrientation",
        "leafOrder",
        "splitRule",
        "padding",
        "duplicateLastNode"
      ],
      "properties": {
        "leafDomain": { "const": "DDT_NETWORK_TRANSACTION_LEAF_V1" },
        "canonicalization": { "const": "RFC8785-JCS" },
        "encoding": { "const": "UTF-8" },
        "digestAlgorithm": { "const": "SHA-256" },
        "leafPrefixHex": { "const": "00" },
        "internalNodePrefixHex": { "const": "01" },
        "leafHashInput": { "const": "HEX(00)||UTF8(RFC8785-JCS(transactionLeaf))" },
        "internalNodeHashInput": { "const": "HEX(01)||RAW(leftDigest)||RAW(rightDigest)" },
        "auditPathOrientation": { "const": "DERIVED_FROM_TRANSACTION_INDEX_TREE_SIZE_AND_SPLIT_RULE" },
        "leafOrder": { "const": "ASCENDING_TRANSACTION_INDEX" },
        "splitRule": { "const": "LARGEST_POWER_OF_TWO_LESS_THAN_N" },
        "padding": { "const": "NONE" },
        "duplicateLastNode": { "const": false }
      }
    },
    "blockHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "canonicalization",
        "encoding",
        "blockIdAlgorithm",
        "blockIdInput",
        "requiredFields"
      ],
      "properties": {
        "domain": { "const": "DDT_TEST_BLOCK_HEADER_V1" },
        "canonicalization": { "const": "RFC8785-JCS" },
        "encoding": { "const": "UTF-8" },
        "blockIdAlgorithm": { "const": "SHA-256" },
        "blockIdInput": { "const": "UTF8(RFC8785-JCS(blockHeaderCore))" },
        "requiredFields": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "domain",
              "networkId",
              "genesisCommitment",
              "height",
              "parentBlockId",
              "transactionCount",
              "transactionRoot",
              "stateRoot",
              "validatorSetId",
              "proposedAtClaim"
            ]
          }
        }
      }
    },
    "finality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "certificateDomain",
        "canonicalization",
        "encoding",
        "coreHashAlgorithm",
        "coreHashInput",
        "signatureProfile",
        "validatorSetRequired",
        "minimumValidSignatures",
        "weightModel",
        "historicalKeyStateRequired"
      ],
      "properties": {
        "model": { "const": "DETERMINISTIC_CERTIFICATE" },
        "certificateDomain": { "const": "DDT_TEST_FINALITY_CERTIFICATE_V1" },
        "canonicalization": { "const": "RFC8785-JCS" },
        "encoding": { "const": "UTF-8" },
        "coreHashAlgorithm": { "const": "SHA-256" },
        "coreHashInput": { "const": "UTF8(RFC8785-JCS(finalityCore))" },
        "signatureProfile": { "$ref": "#/$defs/artifactReference" },
        "validatorSetRequired": { "const": true },
        "minimumValidSignatures": { "const": 1 },
        "weightModel": { "const": "ONE_AUTHORIZED_TEST_SIGNER" },
        "historicalKeyStateRequired": { "const": true }
      }
    },
    "forkHandling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incompatibleFinalizedBlocksAtSameHeight",
        "rpcPreferenceResolvesConflict",
        "laterConflictRewritesEarlierResult",
        "conflictObservationEvidenceRequired"
      ],
      "properties": {
        "incompatibleFinalizedBlocksAtSameHeight": { "const": "CONFLICTING" },
        "rpcPreferenceResolvesConflict": { "const": false },
        "laterConflictRewritesEarlierResult": { "const": false },
        "conflictObservationEvidenceRequired": { "const": true }
      }
    },
    "timePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockTimeClaimStatus",
        "blockTimeIsIndependentUtcProof",
        "externalTimeRequiresSeparateEvidence"
      ],
      "properties": {
        "blockTimeClaimStatus": { "const": "ASSERTED" },
        "blockTimeIsIndependentUtcProof": { "const": false },
        "externalTimeRequiresSeparateEvidence": { "const": true }
      }
    },
    "resultModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axes", "finalityStatuses"],
      "properties": {
        "axes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["axisId", "statusClass"],
            "properties": {
              "axisId": {
                "enum": [
                  "NETWORK_TARGET_BINDING",
                  "NETWORK_OBJECT_INCLUSION",
                  "NETWORK_FINALITY"
                ]
              },
              "statusClass": {
                "enum": ["BINDING", "VALIDITY", "FINALITY"]
              }
            }
          }
        },
        "finalityStatuses": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "FINALIZED",
              "CONFIRMED_PROBABILISTIC",
              "NOT_FINAL",
              "REVERTED",
              "CONFLICTING",
              "UNAVAILABLE",
              "UNRESOLVED",
              "NOT_APPLICABLE",
              "NOT_EVALUATED"
            ]
          }
        }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finalityImpliesExternalUtcTime",
        "finalityImpliesSourceCompleteness",
        "finalityImpliesSignerAuthority",
        "finalityImpliesSubstantiveTruth",
        "testProfileImpliesProductionDdcFinality"
      ],
      "properties": {
        "finalityImpliesExternalUtcTime": { "const": false },
        "finalityImpliesSourceCompleteness": { "const": false },
        "finalityImpliesSignerAuthority": { "const": false },
        "finalityImpliesSubstantiveTruth": { "const": false },
        "testProfileImpliesProductionDdcFinality": { "const": false }
      }
    }
  }
}
